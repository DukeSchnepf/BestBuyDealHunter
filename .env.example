# ───────────────────────────── Best Buy Deal Hunter ─────────────────────────────
# Copy this file to ".env" and fill in your values.  ".env" is gitignored.

# REQUIRED ── Your Best Buy Developer API key (free: https://developer.bestbuy.com/).
BBY_API_KEY=

# REQUIRED ── Discord webhook URL for the channel that should receive deal alerts.
# Discord → Channel Settings → Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=

# ───────────────────────────── Watcher behaviour ────────────────────────────────
# Minutes between scans in --watch mode (default 12; keeps us well under rate limits).
POLL_INTERVAL_MINUTES=12

# Optional hard price ceiling in USD. Leave blank for "no cap" (rank by quality only).
PRICE_CAP=

# Comma-separated SKUs to stalk for open-box drops (e.g. 6614153,6594299). Optional.
WATCH_SKUS=

# ───────────────────────────── Curation tuning (optional) ───────────────────────
# Minimum item price (USD) to consider — filters out cheap sticker/cable noise.
MIN_PRICE=15

# Minimum RTX 50-series tier to flag as a priority GPU target.
# 1=5060  2=5060 Ti  3=5070  4=5070 Ti  5=5080  6=5090
GPU_MIN_TIER=1

# Discount thresholds (percent) per category bucket.
THRESHOLD_CORE=15           # laptops / desktops / GPUs / CPUs
THRESHOLD_COMPONENT=20      # RAM / SSD / motherboard / PSU / case
THRESHOLD_MONITOR=20        # monitors
THRESHOLD_PERIPHERAL=35     # gaming keyboards / mice / headsets / controllers

# Dollar-savings shortcut: core-compute items always pass if they save at least this much.
CORE_DOLLAR_FLOOR=75

# Max deals to push to Discord per scan cycle (avoids spam on first run).
MAX_ALERTS_PER_CYCLE=15
