# ───────────────────────────── Best Buy Deal Hunter ─────────────────────────────
# Copy this file to ".env" and fill in your values.  ".env" is gitignored.
# At least ONE source (Best Buy and/or eBay) must be configured.

# ── Best Buy (free key: https://developer.bestbuy.com/) ──
BBY_API_KEY=

# ── Discord ── webhook URL for normal deal alerts.
# Discord → Channel Settings → Integrations → Webhooks → New Webhook → Copy URL.
DISCORD_WEBHOOK_URL=

# Optional: a SEPARATE webhook for price-error/glitch alerts (a dedicated #glitches
# channel). If blank, glitches go to DISCORD_WEBHOOK_URL.
DISCORD_GLITCH_WEBHOOK_URL=

# Optional: who to ping on a glitch (price errors die fast). e.g. @here or <@&ROLE_ID>.
GLITCH_PING=

# ── eBay (free keyset: https://developer.ebay.com/) ──
# Enables used / open-box / refurbished RTX 5060+ hunting + glitch detection on eBay.
# Auto-enabled when both are set; or force with EBAY_ENABLED=true/false.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_US

# ───────────────────────────── Watcher behaviour ────────────────────────────────
# Minutes between scans in --watch mode (default 12; keeps us well under rate limits).
POLL_INTERVAL_MINUTES=12

# Optional hard price ceiling in USD. Leave blank for "no cap" (rank by quality only).
PRICE_CAP=

# ── Fast watchlist poll (for catching glitches that die in minutes) ──
# When set (and a watchlist exists), the bot polls just the watchlist this often,
# in addition to the slower full sweep above. 0 = disabled.
WATCH_INTERVAL_MINUTES=0
# Comma-separated Best Buy SKUs to stalk for open-box drops (e.g. 6614153,6594299).
WATCH_SKUS=
# Comma-separated eBay search terms to poll fast (e.g. RTX 5090 laptop, RTX 5080 laptop).
WATCH_TERMS=

# ───────────────────────────── Price history (SQLite) ───────────────────────────
# Keep per-cycle samples this many days, then compact to daily min/median/high.
PRICE_RAW_DAYS=7
# Keep the daily rollups this many days (the glitch baseline window).
PRICE_RETENTION_DAYS=90

# ───────────────────────────── Curation tuning (optional) ───────────────────────
# Minimum item price (USD) to consider — filters out cheap sticker/cable noise.
MIN_PRICE=15

# Minimum RTX 50-series tier to flag as a priority GPU target.
# 1=5060  2=5060 Ti  3=5070  4=5070 Ti  5=5080  6=5090
GPU_MIN_TIER=1

# Discount thresholds (percent) per category bucket.
THRESHOLD_CORE=15           # laptops / desktops / GPUs / CPUs
THRESHOLD_COMPONENT=20      # RAM / SSD / motherboard / PSU / case
THRESHOLD_MONITOR=20        # monitors
THRESHOLD_PERIPHERAL=35     # gaming keyboards / mice / headsets / controllers

# Dollar-savings shortcut: core-compute items always pass if they save at least this much.
CORE_DOLLAR_FLOOR=75

# Max NORMAL deals to push to Discord per scan cycle (glitches are never capped).
MAX_ALERTS_PER_CYCLE=15

# ───────────────────────────── Price-error / glitch detector ────────────────────
GLITCH_ENABLED=true
# Price must fall to/below this fraction of the product's historical LOW to flag.
GLITCH_FLOOR_RATIO=0.60        # 0.60 => 40%+ under the lowest price ever seen
# ...or this fraction of its rolling MEDIAN.
GLITCH_MEDIAN_RATIO=0.50
# ...or this fraction of MSRP/regular (works with zero history).
GLITCH_MSRP_RATIO=0.40        # 0.40 => 60%+ off list price
# History samples required before floor/median signals are trusted.
GLITCH_MIN_HISTORY=4
# Robust outlier signal: flag a price this many MADs below the median.
GLITCH_MAD_Z=3.5
GLITCH_MIN_HISTORY_ROBUST=8     # needs more history than floor/median
# Rate-of-change: a single-cycle price drop this large looks like a sudden error.
GLITCH_DROP_RATIO=0.50          # 0.50 => price halved since the previous observation
# Minimum combined confidence (0-1) to fire a glitch alert.
GLITCH_MIN_CONFIDENCE=0.6
